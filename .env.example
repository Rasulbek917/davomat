# ---------------------------------------------------------------------------
# Maktab Davomat — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/davomat?schema=public"

# 48+ byte random secret used to sign/derive session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-value"

# 32-byte (base64) AES-256-GCM key used to encrypt third-party integration
# credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY="replace-me-with-base64-32-bytes"

# Public base URL of the app (used for absolute links / exports)
APP_URL="http://localhost:3000"

# Directory for uploaded files (avatars). Relative to the project root or absolute.
UPLOAD_DIR="storage/uploads"

# Timezone used for all attendance/date calculations
APP_TIMEZONE="Asia/Tashkent"

# Seed script: initial Super Admin credentials (development only).
# The account is created on first `npm run db:seed`; change the password after login.
SEED_SUPERADMIN_LOGIN="superadmin"
SEED_SUPERADMIN_PASSWORD="ChangeMe!2026"

# ---------------------------------------------------------------------------
# eMaktab integration (OPTIONAL — leave empty unless you have an OFFICIAL,
# authorised integration. See docs/EMAKTAB_INTEGRATION.md)
# ---------------------------------------------------------------------------
# Base URL of the official eMaktab API, if and only if one is officially provided.
EMAKTAB_API_BASE_URL=""
# Credentials are stored encrypted in the database via the Integration UI.
# Do NOT hardcode them here unless you are certain of the deployment security.

# ---------------------------------------------------------------------------
# AI assistant (OPTIONAL — server-side only, never exposed to the client).
# Any OpenAI-compatible endpoint works. Leave AI_API_KEY empty to disable AI
# (the UI then shows a "not configured" state; everything else keeps working).
# See docs/AI_ASSISTANT.md
# ---------------------------------------------------------------------------
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Hard cap on a single response, and a per-user daily request budget.
AI_MAX_OUTPUT_TOKENS="900"
AI_DAILY_REQUEST_LIMIT="150"
